# Immutable production image tag or, preferably, manifest digest.
TRUSTTUNNEL_IMAGE=ghcr.io/reansn0w/trusttunnel-controller:v0.2.1

# Optional initial ACME identity. Set both for background issuance on first start.
# Existing saved TLS settings take precedence after the initial setup.
# TT_TLS_HOSTNAME=vpn.example.com
# TT_ACME_EMAIL=admin@example.com
