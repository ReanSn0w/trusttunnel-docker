# Immutable production image tag or, preferably, manifest digest.
TRUSTTUNNEL_IMAGE=ghcr.io/reansn0w/trusttunnel-controller:v0.2.1

# Initial TLS source: letsencrypt, self-signed, or provided.
# Set the hostname for every source. ACME email applies only to letsencrypt.
# Existing saved TLS settings take precedence after the initial setup.
# TT_TLS_SOURCE=letsencrypt
# TT_TLS_HOSTNAME=vpn.example.com
# TT_ACME_EMAIL=admin@example.com
# Self-signed example: use TT_TLS_SOURCE=self-signed and TT_TLS_HOSTNAME only.
# No ACME email is needed in that mode.
# For provided, mount the pair read-only and set paths inside the container.
# TT_TLS_SOURCE=provided
# TT_TLS_CERTIFICATE_FILE=/run/tls/cert.pem
# TT_TLS_KEY_FILE=/run/tls/key.pem
# For the provided Compose override, set TT_PROVIDED_TLS_DIR to an absolute host directory.
# TT_PROVIDED_TLS_DIR=/srv/trusttunnel-certs
